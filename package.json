{
  "name": "coast",
  "version": "0.1.0",
  "private": true,
  "description": "COAST — Centralised Order And Shipment Tracking",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "check": "npm run typecheck && npm run lint && npm run test && npm run build",
    "db:push": "supabase db push",
    "db:seed-demo": "tsx --env-file=.env.local scripts/seed-demo.ts",
    "org:create": "tsx --env-file=.env.local scripts/create-org.ts",
    "demo:logins": "tsx --env-file=.env.local scripts/demo-logins.ts",
    "leads": "tsx --env-file=.env.local scripts/leads.ts",
    "credentials:rotate": "tsx --conditions=react-server --env-file=.env.local scripts/rotate-credentials.ts"
  },
  "dependencies": {
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.117.3",
    "next": "16.4.0",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "server-only": "0.0.1"
  },
  "devDependencies": {
    "@playwright/test": "1.64.0",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.0",
    "supabase": "2.120.0",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.4"
  }
}
