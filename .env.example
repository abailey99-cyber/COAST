# COAST — environment variables
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional: leave a block empty and that integration
# reports "unconfigured" instead of failing.

# ── Foundation (required) ───────────────────────────────────────────
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=           # e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # the "anon" key, or the newer "publishable" key (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=          # the "service_role" key, or the newer "secret" key (sb_secret_…). Server-only: admin scripts and cron jobs. Bypasses all security — never share it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                        # long random string (32+ characters); guards /api/cron/*
COAST_ENV=development               # development | staging | production — demo seeding refuses production

# ── Development only ────────────────────────────────────────────────
DEMO_USER_PASSWORD=                 # password for the demo sign-ins created by `npm run db:seed-demo` (12+ characters)

# ── Microsoft 365 email (docs/integrations/microsoft365.md) ─────────
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=
M365_MAILBOX=                       # e.g. po-confirm@yourdomain.com

# ── NetSuite read-only sync (docs/integrations/netsuite.md) ─────────
NETSUITE_ENV=sandbox                # sandbox | production
NETSUITE_ACCOUNT_ID=
NETSUITE_CLIENT_ID=
NETSUITE_CLIENT_SECRET=
NETSUITE_CERTIFICATE_ID=            # confirm against Oracle docs (M2M flow)
NETSUITE_PRIVATE_KEY=

# ── Carriers — public APIs (docs/integrations/carrier-tracking.md) ──
DHL_API_KEY=
FEDEX_CLIENT_ID=                    # also used for TNT
FEDEX_CLIENT_SECRET=
UPS_CLIENT_ID=
UPS_CLIENT_SECRET=

# ── Carriers — best-effort, need a real integration pack ────────────
DPD_API_KEY=
ROYAL_MAIL_CLIENT_ID=
ROYAL_MAIL_CLIENT_SECRET=
HERMES_API_KEY=                     # Evri
YODEL_API_KEY=
