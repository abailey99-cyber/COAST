# COAST — environment variables
# Copy to .env.local for local development. Never commit real values.
# Every integration is optional: leave a block empty and that integration
# reports "unconfigured" instead of failing.

# ── Foundation (required) ───────────────────────────────────────────
# Supabase → Project Settings → API Keys.
NEXT_PUBLIC_SUPABASE_URL=           # e.g. https://abcdefghijkl.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=      # the "anon" key, or the newer "publishable" key (sb_publishable_…)
SUPABASE_SERVICE_ROLE_KEY=          # the "service_role" key, or the newer "secret" key (sb_secret_…). Server-only: admin scripts and cron jobs. Bypasses all security — never share it.
NEXT_PUBLIC_APP_URL=http://localhost:3000
CRON_SECRET=                        # long random string (32+ characters); guards /api/cron/*
COAST_ENV=development               # development | staging | production — demo seeding refuses production

# ── Development only ────────────────────────────────────────────────
DEMO_USER_PASSWORD=                 # password for the demo sign-ins created by `npm run db:seed-demo` (12+ characters)

# ── Integration credentials (readiness Task 2, decision N3) ────────
# Each organisation connects its own carriers, NetSuite and Microsoft 365
# tenant in Settings → Integrations; COAST encrypts those secrets with this
# key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Format: version:key, comma-separated. The highest version is used for new
# secrets. To rotate: add 2:<new key>, run `npm run credentials:rotate`,
# then remove 1:… . Use a DIFFERENT key in each environment. Losing it means
# every organisation must reconnect.
COAST_CREDENTIAL_KEYS=              # e.g. 1:<base64 of 32 random bytes>

# ── COAST's own Microsoft 365 app (docs/integrations/microsoft365.md) ─
# One multi-tenant app for all of COAST. Each organisation's admin grants it
# consent for their own tenant and mailbox (Task 3).
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Carriers, NetSuite and each organisation's mailbox are NOT set here any
# more: they're per organisation, encrypted, in Settings → Integrations.
